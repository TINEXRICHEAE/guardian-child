# Guardian mobile app. Copy to .env and set the address of the Django site.
# Leave EXPO_PUBLIC_SITE_URL unset to use SITE_URL from ../pita/.env.
#
# On a real phone, localhost is the phone itself: use the laptop's address on the same Wi-Fi,
# e.g. http://192.168.1.20:8001, run Django with `runserver 0.0.0.0:8001`, and add that IP to
# ALLOWED_HOST in pita/.env. The Android emulator reaches the laptop's localhost automatically.
# When Guardian is hosted, set the public https address here and rebuild.
EXPO_PUBLIC_SITE_URL=http://192.168.1.20:8001

# URL prefixes: only needed if they differ from pita/.env (they must match Django).
# EXPO_PUBLIC_AUTH_PREFIX=a4e2b1c9
# EXPO_PUBLIC_PANEL_PREFIX=b2a9e6f1
# EXPO_PUBLIC_PARENT_PREFIX=family
# EXPO_PUBLIC_CHILD_PREFIX=me
