# guardian-ai configuration (plan.md §6.2, §19.1). Copy to .env, never commit .env.

# ── Backend chains, tried left to right ──
# Testbed mode (GPU machine, all local; the default for the demo):
CLASSIFY_BACKENDS=onnx
CLASSIFY_URL_BACKENDS=url-onnx
EMBED_BACKENDS=minilm
# Qwen3-VL-2B official GGUF via llama-server (scripts/start_llama_server.sh) for text and images
EXTRACT_BACKENDS=qwen
EXPLAIN_BACKENDS=qwen
GENERATE_BACKENDS=qwen
# Without llama-server, the slower in-process transformers backend: qwen-hf
# Dev mode on a laptop without the models (cloud; synthetic data only):
# CLASSIFY_BACKENDS=gemini
# EXTRACT_BACKENDS=gemini
# EXPLAIN_BACKENDS=gemini
# GENERATE_BACKENDS=gemini

# ── Cloud switches (Testbed: both false) ──
ALLOW_CLOUD=false
ALLOW_CLOUD_IMAGES=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview

# ── Local models (downloaded to ~/models by ~/models/download.sh) ──
CLASSIFIER_DIR=~/models/distilbert-phish
CLASSIFIER_THRESHOLD=0.5
URL_CLASSIFIER_DIR=~/models/phishing-url
URL_CLASSIFIER_LOCALE=C.UTF-8
EMBED_MODEL_DIR=~/models/all-MiniLM-L6-v2
QWEN_HF_DIR=~/models/qwen3vl-2b
QWEN_HF_DTYPE=float16
# GTX 1060: ~4.4 GB keeps most layers on the GPU; lower it if you see "GPU out of memory"
QWEN_HF_MAX_GPU_MEMORY=4400MiB
QWEN_HF_MAX_CPU_MEMORY=6GiB
# llama-server ("qwen" backend). Use 127.0.0.1: WSL/Windows may resolve localhost to IPv6
QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_MODEL=qwen3-vl-2b
# On the GPU machine llama-server runs on Windows (Hugging Face "Llama" app, Vulkan). From WSL use the Windows host IP
# (ip route show default) instead of 127.0.0.1, and the same key that llama-server was started with (--api-key).
QWEN_API_KEY=

# Shared secret Django sends as X-Guardian-AI-Key. Required on the GPU machine.
GUARDIAN_AI_TOKEN=
