# Guardian web app settings. Copy to pita/.env and fill in. Never commit .env.

# ── Django ──
DATABASE_URL=postgresql://guardian:change-me@localhost:5432/guardian_local
# DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# True for local development only
DEBUG=False
# Public URL of this server, used in practice-email links and tracking
SITE_URL=http://localhost:8001
# Optional extra host for ALLOWED_HOSTS
# ALLOWED_HOST=guardian.example.org

# ── Guardian AI service (guardian-ai/) ──
# Testbed: the SSH tunnel to the GPU machine (guardian-ai/scripts/tunnel.sh) listens on 8100
GUARDIAN_AI_URL=http://localhost:8100
# Must match GUARDIAN_AI_TOKEN in the service's .env
GUARDIAN_AI_TOKEN=
GUARDIAN_AI_TIMEOUT=30
GUARDIAN_AI_EXTRACT_TIMEOUT=120
GUARDIAN_AI_GENERATE_TIMEOUT=600
CLASSIFIER_THRESHOLD=0.5

# Declared cloud fallback when local models fail. Keep False on the Testbed.
GUARDIAN_GEMINI_FALLBACK=False
GEMINI_API_KEY=

# ── Families and practice messages ──
GUARDIAN_SIM_MAX_PER_MONTH=2
# Demo mode: any child with an email can be sent practice messages (and re-sent); the welcome note goes out with
# the first one; consent and the monthly limit are skipped. Set False for real families.
GUARDIAN_PRACTICE_OPEN=True
GUARDIAN_MAX_CHILD_EMAILS_PER_PARENT=5
GUARDIAN_LEARNER_SESSION_DAYS=7
# Optional link shown on the home page
GUARDIAN_ANDROID_APP_URL=

# ── Optional Google sign-in (button hidden when unset) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email: console backend prints emails to the terminal ──
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
# Gmail App Password: myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_TIMEOUT=20
EMAIL_FROM_NAME=Guardian
